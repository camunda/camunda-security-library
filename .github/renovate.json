{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "baseBranchPatterns": ["main"],
  "dependencyDashboard": true,
  "schedule": ["after 10pm every weekday", "before 6am every weekday", "every weekend"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["area/security"]
  },
  "packageRules": [
    {
      "description": "Exclude SNAPSHOT versions — Renovate sometimes proposes them as pre-releases.",
      "matchManagers": ["maven"],
      "allowedVersions": "!/-SNAPSHOT$/"
    },
    {
      "description": "Exclude internal CSL modules.",
      "matchManagers": ["maven"],
      "matchPackageNames": ["/^io\\.camunda:camunda-security-library/"],
      "enabled": false
    },
    {
      "description": "Automerge patch/pin/digest updates that pass CI. Minor and major updates always require human review.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "addLabels": ["automerge"]
    },
    {
      "description": "Skip non-major updates for the renovate bot image used by renovatelint — it is a lint-only container and the frequent minor/patch/digest churn is pure review noise. Major bumps still surface so we don't drift indefinitely.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "enabled": false
    }
  ]
}
