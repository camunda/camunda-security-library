<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.camunda</groupId>
        <artifactId>camunda-security-library</artifactId>
        <version>0.1.0-alpha2</version>
    </parent>

    <artifactId>camunda-security-library-api</artifactId>
    <name>Camunda Security Library — api</name>
    <description>Host-facing entry points for the Camunda Security Library.</description>

    <dependencies>
        <!--
          Cross-module dependency kept for architectural intent: csl-api is
          the host-facing entry point that sits on top of csl-core. Even
          without current source references, this edge in the module graph
          expresses the layering of the library.
        -->
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>camunda-security-library-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test only. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>analyze-dependencies</id>
                        <configuration>
                            <ignoredUnusedDeclaredDependencies combine.children="append">
                                <!-- Cross-module dep kept for architectural intent. -->
                                <ignoredUnusedDeclaredDependency>io.camunda:camunda-security-library-core</ignoredUnusedDeclaredDependency>
                            </ignoredUnusedDeclaredDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
